# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock
*.iml

# flxc output IS committed, on purpose: the app then builds without running
# the compiler first, and `make ci` can fail a tree whose .dart is stale
# relative to its .flx. Never hand-edit those files.

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# macOS
.DS_Store

# Node (legacy prototype transpiler)
node_modules/
packages/flx_lsp/build/

# Server binaries bundled into a VSIX by CI, never committed.
tools/vscode-flx/server/
tools/vscode-flx/*.vsix

# VS Code test harness: a 300MB download and its scratch dirs.
tools/vscode-flx/.vscode-test/
