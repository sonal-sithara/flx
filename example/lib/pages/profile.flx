import "../data/user_repository.dart"
import "settings.dart"

@page("/profile")
composable ProfileScreen {
  val repo  = useInject<UserRepository>()
  val user  = useFetch(repo.currentUser)
  val count = useState(0)
  val nav   = useNavigator()

  Column(padding: 16, gap: 12, main: .center) {
    Avatar(user.photo, size: 64)
    Text(user.name, style: .title)
    Text("Taps: ${count.value}")
    Button("Tap me") {
      count.value++
    }
    Button("Settings") {
      nav.to(SettingsScreen())
    }
    Button("Open user 42") {
      nav.toPath("/user/42")
    }
    Button("Todos") {
      nav.toPath("/todos")
    }
  }
}
