@page("/settings")
composable SettingsScreen {
  val scheme = useColorScheme()
  val size   = useScreenSize()
  val nav    = useNavigator()
  val dark   = useState(false)

  Column(padding: 16, gap: 12, main: .center) {
    Text("Settings", style: .title)
    Text("Screen: ${size.width.toInt()} x ${size.height.toInt()}")
    Text("Primary: ${scheme.primary}", style: .caption)
    Text("Dark mode: ${dark.value}")
    Button("Toggle dark mode") {
      dark.value = !dark.value
    }
    Button("Back") {
      nav.pop()
    }
  }
}
