import "../data/todos_view_model.dart"

@page("/todos")
composable TodosScreen {
  val vm  = useViewModel<TodosViewModel>()
  val nav = useNavigator()

  Column(padding: 16, gap: 12, main: .center) {
    Text("Todos", style: .title)
    Text("${vm.remaining} remaining", style: .caption)
    if (vm.isEmpty) {
      Text("Nothing left to do", style: .caption)
    } else {
      for (todo in vm.todos) {
        Text("${todo.done ? '✓' : '•'} ${todo.title}")
      }
    }
    Button("Add a todo") {
      vm.add("Task ${vm.todos.length + 1}")
    }
    Button("Clear completed") {
      vm.clearCompleted()
    }
    Button("Back") {
      nav.pop()
    }
  }
}
