import 'package:flutter/material.dart';

import 'package:flx/flx.dart';

@page('/feed')
class FeedScreen extends Composable {
  const FeedScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final vm = useViewModel<FeedViewModel>();

    return Scaffold(
      body: [
        SearchField(vm.search, (text) {
          vm.setSearch(text);
        }),
        LazyColumn(items: vm.posts, gap: 8, onEndReached: vm.loadMore, itemBuilder: (post, _) => PostRow(post: post)),
        LazyColumn(items: vm.tags, itemBuilder: (tag, i) => [
            Text("${i + 1}."),
            Text(tag),
          ].row(gap: 4)),
        Button("Refresh", () {
          vm.refresh();
        }),
        Toggle(vm.starred, (on) {
          vm.setStarred(on);
          vm.refresh();
        }),
      ].column(gap: 12).padding(16),
    );
  }
}
