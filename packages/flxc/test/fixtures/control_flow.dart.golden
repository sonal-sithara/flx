import 'package:flutter/material.dart';

import 'package:flx_runtime/flx_runtime.dart';

@page('/inbox')
class InboxScreen extends Composable {
  const InboxScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final messages = useState(["one", "two"]);
    final filter = useState(0);

    return Scaffold(
      body: [
        Text("Inbox", style: Styles.title),
        if (filter.value == 0) ...[
          Text("All", style: Styles.caption),
          Text("showing everything"),
        ] else if (filter.value == 1) ...[
          Text("Unread", style: Styles.caption),
        ] else ...[
          Text("Archived", style: Styles.caption),
        ],
        for (final message in messages.value) ...[
          [
            Text("• "),
            Text(message),
          ].row(gap: 4),
        ],
      ].column(gap: 8).padding(16),
    );
  }
}
