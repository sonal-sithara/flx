import 'package:flutter/material.dart';

import 'package:flx/flx.dart';

@page('/editor')
class EditorScreen extends Composable {
  const EditorScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final text = useTextEditingController();
    final saved = useState(false);
    final labels = useState({"title": "Untitled"});
    final nav = useNavigator();

    return Scaffold(
      body: [
        Text("Editing ${labels.value["title"]}", style: Styles.title),
        Text(r"escaped\path\stays\literal", style: Styles.caption),
        Text("Saved: ${saved.value ? 'yes' : 'no'}"),
        Button("Save", () {
          saved.value = true;
          nav.pop();
        }),
      ].column(gap: 12).padding(16),
    );
  }
}
