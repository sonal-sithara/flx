import 'package:flutter/material.dart';

import 'package:flx/flx.dart';
import '../data/api.dart';

@page('/dashboard')
class DashboardScreen extends Composable {
  const DashboardScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final repo = useInject<Api>();
    final user$ = useFetch(repo.currentUser);
    final stats$ = useFetch(repo.stats, keys: [user$.data?.id]);

    return Scaffold(
      body: user$.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (error) => Center(child: Text('Error: $error')),
        data: (user) {
          return stats$.when(
            loading: () => const Center(child: CircularProgressIndicator()),
            error: (error) => Center(child: Text('Error: $error')),
            data: (stats) {
              return [
                Text(user.name, style: Styles.title),
                Text("Visits: ${stats.visits}", style: Styles.body),
              ].column(gap: 16, main: MainAxisAlignment.center, cross: CrossAxisAlignment.start).padding(24);
            },
          );
        },
      ),
    );
  }
}
