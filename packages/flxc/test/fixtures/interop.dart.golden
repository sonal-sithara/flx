import 'package:flutter/material.dart';

import 'package:flx/flx.dart';
import '../data/bloc.dart';

@page('/interop')
class InteropScreen extends Composable {
  const InteropScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final bloc = useInject<CounterBloc>();
    final state$ = useStream(bloc.stream, initialData: bloc.state);

    return Scaffold(
      body: state$.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (error) => Center(child: Text('Error: $error')),
        data: (state) {
          return [
            LayoutBuilder(builder: (context, box) => Text("width ${box.maxWidth}")),
            ValueListenableBuilder(
              valueListenable: bloc.notifier,
              builder: (context, value, child) => [
                Text("value $value"),
                Text("count ${state.count}"),
              ].column(gap: 4),
            ),
            Scaffold(
              appBar: AppBar(title: Text("Interop")),
              body: [
                Text("a body built in the DSL"),
              ].column(gap: 8).padding(16),
            ),
            Image.asset("logo.png"),
            LazyColumn<Todo>(items: bloc.todos, gap: 4, itemBuilder: (todo, i) => Text("${i + 1}. ${todo.title}")),
            [
              Text("chip"),
            ].wrap(spacing: 8),
            bloc.isEmpty ? EmptyState(title: "Nothing") : Text("Loaded"),
            ...bloc.extraRows,
            Field(controller: bloc.query, onSubmitted: (text) {
              bloc.search(text);
            }),
          ].column(gap: 12);
        },
      ),
    );
