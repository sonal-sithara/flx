import 'package:flutter/material.dart';

import 'package:flx_runtime/flx_runtime.dart';
import 'package:flutter/services.dart' as services;
import '../data/models.dart' show Mode hide Internal;

enum Tone { quiet, loud }

String describe(Tone tone) => tone == Tone.loud ? "loud" : "quiet";

class Box<T> extends Composable {
  const Box({required this.item, required this.render, super.key});

  final T item;
  final String Function(T) render;

  @override
  Widget build(BuildContext context) {
    return Text(render(item));
  }
}

@page('/language')
class LanguageScreen extends Composable {
  const LanguageScreen({required this.id, super.key});

  final String id;

  @override
  Widget build(BuildContext context) {
    final Tone tone = Tone.quiet;
    final vm = useViewModel<Model>();
    final header = Text("a widget in a binding");
    vm.warmUp();

    return Scaffold(
      body: [
        const Text("const child"),
        header,
        Box<Tone>(item: tone, render: describe),
        LayoutBuilder(builder: (context, box) => Text("${box.maxWidth}")),
        Field(controller: vm.query, onSubmitted: (String value) {
          vm.search(value);
        }),
        Button("Save", () async {
          await vm.save();
        }),
        switch(tone) {Tone.loud => Text("loud"), _ => Text("quiet")},
        ...vm.extras,
      ].column(gap: 8),
    );
  }
}
