import 'package:flutter/material.dart';

import 'package:flx_runtime/flx_runtime.dart';

class Badge extends Composable {
  const Badge({required this.label, this.tone = Colors.grey, super.key});

  final String label;
  final Color tone;

  @override
  Widget build(BuildContext context) {
    return Text(label, style: Styles.caption);
  }
}

class EmptyState extends Composable {
  const EmptyState({required this.title, required this.subtitle, super.key});

  final String title;
  final String subtitle;

  @override
  Widget build(BuildContext context) {
    return [
      Text(title, style: Styles.subtitle),
      Text(subtitle, style: Styles.caption),
    ].column(gap: 4).center();
  }
}

@page('/library/:shelf')
class LibraryScreen extends Composable {
  const LibraryScreen({required this.shelf, super.key});

  final String shelf;

  @override
  Widget build(BuildContext context) {
    final books = useState([]);

    return Scaffold(
      body: [
        Badge(shelf),
        if (books.value.isEmpty) ...[
          EmptyState("Nothing here", "Add a book to get started"),
        ] else ...[
          for (final book in books.value) ...[
            Text(book.title),
          ],
        ],
      ].column(gap: 12).padding(16).safeArea(),
    );
  }
}
